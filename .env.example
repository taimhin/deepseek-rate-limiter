# ============================================================
#  DeepSeek rate limiter proxy - environment variables
#  Copy this file to `.env` and fill in your API key.
# ============================================================

# --- Required -------------------------------------------------
# Your DeepSeek API key (server-side only, never sent to clients)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Server ---------------------------------------------------
HOST=127.0.0.1
PORT=8787

# Optional: require clients to send this key as
# `Authorization: Bearer <PROXY_API_KEY>` or `x-api-key`.
# Leave empty to disable proxy authentication.
PROXY_API_KEY=

# Optional CORS origin (e.g. http://localhost:3000). Empty = disabled.
CORS_ORIGIN=

LOG_LEVEL=info

# --- Upstream -------------------------------------------------
# Base URL of the DeepSeek API (without /chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Per-attempt timeout in milliseconds (long reasoning streams can be slow)
REQUEST_TIMEOUT_MS=600000

# --- Rate limits ----------------------------------------------
# Requests per minute (RPM)
DEEPSEEK_RPM=60
# Tokens per minute (TPM), prompt + reserved completion tokens
DEEPSEEK_TPM=60000
# Maximum simultaneous in-flight upstream requests
DEEPSEEK_MAX_CONCURRENCY=8
# Extra burst allowance, as a multiplier of one minute of quota (1 = no extra burst)
DEEPSEEK_BURST_MULTIPLIER=1

# --- Queue ----------------------------------------------------
# Maximum number of requests waiting for capacity (0 = reject immediately)
DEEPSEEK_MAX_QUEUE_SIZE=200
# How long a request may wait in the queue before returning 429 (0 = no timeout)
DEEPSEEK_QUEUE_TIMEOUT_MS=120000

# --- Daily budget (0 = disabled) ------------------------------
DEEPSEEK_DAILY_TOKEN_QUOTA=0
DEEPSEEK_DAILY_REQUEST_QUOTA=0
# Day boundary offset from UTC, in minutes (e.g. 480 = UTC+8)
DEEPSEEK_UTC_OFFSET_MINUTES=0

# --- Retry ----------------------------------------------------
# Number of retries after the first attempt (0 = no retry)
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_RETRY_BASE_MS=500
DEEPSEEK_RETRY_MAX_MS=30000

# --- Token estimation ----------------------------------------
# Completion tokens to reserve when a request does not set max_tokens
DEEPSEEK_EXPECTED_COMPLETION_TOKENS=512
# Ask DeepSeek to include usage in streaming responses (recommended)
DEEPSEEK_FORCE_INCLUDE_USAGE=true
